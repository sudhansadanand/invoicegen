# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit secrets.toml to version control.

[auth]
# A long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"

# The URL Streamlit redirects to after Google login.
# For local dev: "http://localhost:8501/oauth2callback"
# For production: "https://yourdomain.com/oauth2callback"
redirect_uri = "http://localhost:8501/oauth2callback"

[auth.google]
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
